[Desktop Entry]
Type=Application
Name=Photon
Comment=Fast, modern photo management application for GNOME
Exec=photon %F
Icon=org.mavensgroup.photon
Terminal=false
Categories=Graphics;Photography;GNOME;GTK;
MimeType=image/jpeg;image/png;image/tiff;image/webp;image/x-canon-cr2;image/x-canon-cr3;image/x-nikon-nef;image/x-sony-arw;image/x-fuji-raf;image/x-panasonic-rw2;image/x-olympus-orf;image/x-adobe-dng;
StartupWMClass=org.mavensgroup.photon
Keywords=photo;photos;pictures;raw;viewer;gallery;organization;culling;lightroom;
